# Next.js Square API Configuration
# Get credentials from Square Developer Dashboard: https://developer.squareup.com/apps

# Square Application ID (Starts with sandbox-sq0idb- or sq0idp-)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=sandbox-sq0idb-DEMO_CozyCubsAppId

# Square Location ID (Starts with sandbox-sq0lic- or L...)
NEXT_PUBLIC_SQUARE_LOCATION_ID=sandbox-sq0lic-DEMO_SydneyHubLocation

# Square Access Token (Starts with EAAA... - KEEP THIS SECRET!)
SQUARE_ACCESS_TOKEN=

# Environment: sandbox or production
SQUARE_ENVIRONMENT=sandbox
