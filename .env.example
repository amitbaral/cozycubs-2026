# Next.js Square API Configuration
# Get credentials from Square Developer Dashboard: https://developer.squareup.com/apps

# Square Application ID (Starts with sandbox-sq0idb- or sq0idp-)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=

# Square Location ID (Starts with sandbox-sq0lic- or L...)
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Square Access Token (Starts with EAAA... - KEEP THIS SECRET!)
SQUARE_ACCESS_TOKEN=

# Environment: sandbox or production
SQUARE_ENVIRONMENT=sandbox

# Resend (https://resend.com) - order confirmations, contact form, newsletter welcome
RESEND_API_KEY=
EMAIL_FROM=Cozy Cubs Australia <info@cozycubs.au>
BUSINESS_EMAIL=info@cozycubs.au

# Vercel Blob - customer photo uploads (Vercel dashboard > Storage > Blob)
BLOB_READ_WRITE_TOKEN=
